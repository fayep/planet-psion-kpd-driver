# xbindkeys configuration for Cosmo Communicator (Gemian Linux / KDE)
#
# Install: cp xbindkeysrc ~/.xbindkeysrc && xbindkeys
#
# Meta+F generates XF86RFKill (airplane/Wi-Fi toggle).  KDE and urfkill do not
# handle this keysym reliably on the Cosmo 4.4 kernel, so we handle it here.

"~/bin/toggle-wifi.sh"
    Mod5 + f
